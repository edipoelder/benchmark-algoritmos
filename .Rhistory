```{r load}
```{r load}
knitr::opts_chunk$set(
echo    = TRUE,
warning = FALSE,
message = FALSE,
fig.align = "center"
)
library(ggplot2)
library(tidyr)
library(dplyr)
library(knitr)
library(stringr)
tempos <- read.csv("tempos_sort.csv", check.names = FALSE)
View(tempos)
# Converte colunas Tamanho_X em linhas
tempos_longo <- tempos |>
pivot_longer(
cols      = starts_with("Tamanho_"),
names_to  = "Tamanho",
values_to = "Tempo_ns"
) |>
mutate(
Tamanho = as.integer(str_remove(Tamanho, "Tamanho_")),
Caso = factor(Caso.de.teste,
levels = c("Melhor caso (vetor já ordenado)",
"Pior caso (vetor em ordem inversa)",
"Caso médio (vetor aleatório)"))
)
# Converte colunas Tamanho_X em linhas
tempos_longo <- tempos |>
pivot_longer(
cols      = starts_with("Tamanho_"),
names_to  = "Tamanho",
values_to = "Tempo_ns"
) |>
mutate(
Tamanho = as.integer(str_remove(Tamanho, "Tamanho_")),
Caso = factor(Caso_de_teste,
levels = c("Melhor caso (vetor já ordenado)",
"Pior caso (vetor em ordem inversa)",
"Caso médio (vetor aleatório)"))
)
# Função auxiliar para plotar um algoritmo específico
plotar_algoritmo <- function(nome, cor = "steelblue") {
dados <- filter(tempos_longo, Algoritmo == nome)
ggplot(dados, aes(x = Tamanho, y = Tempo_ns, color = Caso)) +
geom_line(linewidth = 1) +
geom_point(size = 1.5) +
labs(
title = nome,
x     = "Tamanho do vetor",
y     = "Tempo (ns)",
color = "Caso de teste"
) +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
}
knitr::opts_chunk$set(
echo    = TRUE,
warning = FALSE,
message = FALSE,
fig.align = "center"
)
library(ggplot2)
library(tidyr)
library(dplyr)
library(knitr)
library(stringr)
tempos <- read.csv("tempos_sort.csv", check.names = FALSE)
# Converte colunas Tamanho_X em linhas, renomeia os casos
# e converte o tempo de nanossegundos para milissegundos.
tempos_longo <- tempos |>
pivot_longer(
cols      = starts_with("Tamanho_"),
names_to  = "Tamanho",
values_to = "Tempo_ns"
) |>
mutate(
Tamanho = as.integer(str_remove(Tamanho, "Tamanho_")),
Caso = factor(
case_when(
Caso_de_teste == "Melhor caso (vetor já ordenado)"    ~ "Melhor caso",
Caso_de_teste == "Pior caso (vetor em ordem inversa)" ~ "Pior caso",
Caso_de_teste == "Caso médio (vetor aleatório)"       ~ "Caso médio",
TRUE ~ Caso_de_teste
),
levels = c("Melhor caso", "Pior caso", "Caso médio")
),
Tempo_ms = Tempo_ns * 0.000001
)
# Função auxiliar para plotar um algoritmo específico
plotar_algoritmo <- function(nome, cor = "steelblue") {
dados <- filter(tempos_longo, Algoritmo == nome)
ggplot(dados, aes(x = Tamanho, y = Tempo_ms, color = Caso)) +
geom_line(linewidth = 1) +
geom_point(size = 1.5) +
labs(
title = nome,
x     = "Tamanho do vetor",
y     = "Tempo (ms)",
color = "Caso de teste"
) +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
}
plotar_algoritmo("Insertion sort", "tomato")
plotar_algoritmo("Selection sort", "steelblue")
View(tempos)
